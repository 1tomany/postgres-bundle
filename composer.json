{
    "name": "1tomany/postgres-bundle",
    "description": "Symfony bundle that enhances Postgres for Doctrine",
    "license": "MIT",
    "type": "symfony-bundle",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "doctrine/dbal": "^4.4",
        "doctrine/orm": "^3.6",
        "symfony/config": "^7.2|^8.0|^8.1",
        "symfony/dependency-injection": "^7.2|^8.0|^8.1",
        "symfony/http-kernel": "^7.2|^8.0|^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.93",
        "phpstan/phpstan": "^2.1.55",
        "phpunit/phpunit": "^13.1.11"
    },
    "autoload": {
        "psr-4": {
            "OneToMany\\PostgresBundle\\": "src/"
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OneToMany\\PostgresBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "fix": "php-cs-fixer fix",
        "stan": "phpstan",
        "test": "phpunit",
        "flat": [
            "@fix",
            "@stan",
            "@test"
        ]
    },
    "authors": [
        {
            "name": "Vic Cherubini",
            "email": "vcherubini@gmail.com"
        }
    ],
    "config": {
        "sort-packages": true
    }
}
